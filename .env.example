# ============================================================
# MOTOBOX ANGOLA — Variáveis de ambiente
# Copiar para `.env.local` e preencher com os valores do
# projecto Supabase (Project Settings → API).
#
# `.env.local` está no .gitignore e NUNCA deve ser commitado.
# ============================================================

# URL do projecto — pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Chave anónima (publishable) — pode ir para o navegador.
# Está sujeita a Row Level Security: só lê conteúdo publicado.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Chave de service role — IGNORA todas as políticas de segurança.
# NUNCA prefixar com NEXT_PUBLIC_. NUNCA usar em componentes de
# cliente. É lida apenas no servidor, pelas rotas /api/admin.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
